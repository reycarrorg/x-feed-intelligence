{
  "name": "x-feed-intelligence-extension",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Explicit, local-only, popup-controlled visible-post collector for X Feed Intelligence.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:wxt": "wxt prepare",
    "build": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "dev:firefox": "wxt -b firefox",
    "run:firefox": "pnpm dlx web-ext@10.6.0 run --source-dir .output/firefox-mv3 --no-reload --start-url about:debugging#/runtime/this-firefox --no-input",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "zip": "wxt zip -b chrome"
  },
  "devDependencies": {
    "@types/chrome": "0.1.32",
    "happy-dom": "20.8.9",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  }
}
