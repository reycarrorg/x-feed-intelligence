{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.x-feed-intelligence.invalid/v2/observation.schema.json",
  "title": "Visible live-DOM post observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "session_id", "appearance_index", "top_level", "visibility_ratio", "document_visible", "platform_post_id", "canonical_permalink", "visible_text", "authors", "relationships", "media", "promotion", "provenance", "uncertainty", "input_location", "preview_grade", "preview_reasons"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "appearance_index": {"type": "integer", "minimum": 0},
    "top_level": {"const": true},
    "visibility_ratio": {"type": "number", "minimum": 0.5, "maximum": 1},
    "document_visible": {"const": true},
    "platform_post_id": {"type": ["string", "null"], "maxLength": 256},
    "canonical_permalink": {"type": ["string", "null"], "pattern": "^https://x\\.com/"},
    "visible_text": {"type": ["string", "null"], "maxLength": 10000},
    "outbound_links": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["url", "title", "description"], "properties": {"url": {"type": "string", "pattern": "^https://", "maxLength": 2048}, "title": {"type": ["string", "null"], "maxLength": 512}, "description": {"type": ["string", "null"], "maxLength": 2048}}}},
    "quote_context": {"type": ["object", "null"], "additionalProperties": false, "required": ["platform_post_id", "canonical_permalink", "display_name", "handle", "visible_text", "media"], "properties": {"platform_post_id": {"type": ["string", "null"], "maxLength": 256}, "canonical_permalink": {"type": ["string", "null"], "pattern": "^https://x\\.com/"}, "display_name": {"type": ["string", "null"], "maxLength": 256}, "handle": {"type": ["string", "null"], "maxLength": 64}, "visible_text": {"type": ["string", "null"], "maxLength": 10000}, "media": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "alt_text"], "properties": {"kind": {"type": "string", "enum": ["image", "video", "animated_image", "link_card", "unknown"]}, "alt_text": {"type": ["string", "null"], "maxLength": 4096}}}}}},
    "first_observed_at": {"type": "string", "format": "date-time"},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "displayed_timestamp": {"type": ["string", "null"], "maxLength": 128},
    "authors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/AuthorRef"}},
    "relationships": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/Relationship"}},
    "media": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/Media"}},
    "promotion": {"$ref": "common.schema.json#/$defs/PromotedCard"},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/Provenance"}},
    "uncertainty": {"type": "array", "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/Uncertainty"}},
    "input_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport_time_ms", "video_time_ms", "crop_xywh"],
      "properties": {
        "viewport_time_ms": {"type": "integer", "minimum": 0},
        "video_time_ms": {"const": null},
        "crop_xywh": {"const": null}
      }
    },
    "preview_grade": {"type": "string", "enum": ["A", "B", "C", "D", "E", "F"]},
    "preview_reasons": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
