{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.x-feed-intelligence.invalid/v2/session.schema.json",
  "title": "Explicit live-DOM collection session v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "schema_version", "source", "started_at", "ended_at", "origin", "collector_version", "privacy_profile", "collection_mode", "limits"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "schema_version": {"const": "2.0.0"},
    "source": {"const": "live_dom"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "origin": {"const": "https://x.com"},
    "collector_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "privacy_profile": {"const": "default_local"},
    "collection_mode": {"const": "manual_scroll"},
    "limits": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["max_candidates", "max_duration_seconds", "max_packet_bytes"], "properties": {"max_candidates": {"const": 100}, "max_duration_seconds": {"const": 900}, "max_packet_bytes": {"const": 5242880}}},
        {"type": "object", "additionalProperties": false, "required": ["max_candidates", "max_duration_seconds", "max_packet_bytes"], "properties": {"max_candidates": {"const": 10000}, "max_duration_seconds": {"const": 28800}, "max_packet_bytes": {"const": 134217728}}}
      ]
    }
  }
}
