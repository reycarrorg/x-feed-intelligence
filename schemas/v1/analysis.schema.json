{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.x-feed-intelligence.invalid/v1/analysis.schema.json",
  "title": "Post analysis and report contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_id", "local_post_id", "classification", "score", "manual_action", "verification", "recommendations", "uncertainty", "redactions"],
  "properties": {
    "analysis_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "local_post_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "classification": {"type": "string", "enum": ["A_HIGH_SIGNAL", "B_PROMISING_VERIFY", "C_COMMUNITY_LIGHT_VALUE", "D_LOW_SIGNAL_SLOP", "E_SCAM_MANIPULATIVE_UNSAFE", "F_INSUFFICIENT_INFORMATION"]},
    "score": {"$ref": "common.schema.json#/$defs/Score"},
    "manual_action": {"type": "string", "enum": ["KNOW_NOW", "INVESTIGATE", "TRY_SAFELY", "INCORPORATE", "BOOKMARK", "CONSIDER_LIKING", "CONSIDER_FOLLOWING_AUTHOR", "WATCHLIST_AUTHOR", "ENJOY_COMMUNITY", "IGNORE", "MUTE_SIGNAL", "AVOID_REPORT_IF_APPROPRIATE", "CANNOT_ASSESS"]},
    "verification": {"type": "array", "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/Verification"}},
    "recommendations": {"type": "array", "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/Recommendation"}},
    "uncertainty": {"type": "array", "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/Uncertainty"}},
    "redactions": {"type": "array", "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/Redaction"}}
  }
}
