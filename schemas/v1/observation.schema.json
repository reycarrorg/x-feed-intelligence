{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.x-feed-intelligence.invalid/v1/observation.schema.json",
  "title": "Visible-card observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "session_id", "appearance_index", "top_level", "visibility_ratio", "document_visible", "platform_post_id", "canonical_permalink", "visible_text", "authors", "relationships", "media", "promotion", "provenance", "uncertainty", "input_location"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "appearance_index": {"type": "integer", "minimum": 0},
    "top_level": {"const": true},
    "visibility_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "document_visible": {"type": "boolean"},
    "platform_post_id": {"type": ["string", "null"], "maxLength": 256},
    "canonical_permalink": {"type": ["string", "null"], "pattern": "^https://x\\.com/|^https://example\\.invalid/"},
    "visible_text": {"type": ["string", "null"], "maxLength": 10000},
    "displayed_timestamp": {"type": ["string", "null"], "maxLength": 128},
    "authors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/AuthorRef"}},
    "relationships": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/Relationship"}},
    "media": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/Media"}},
    "promotion": {"$ref": "common.schema.json#/$defs/PromotedCard"},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/Provenance"}},
    "uncertainty": {"type": "array", "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/Uncertainty"}},
    "input_location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "video_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "crop_xywh": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4}
      }
    }
  }
}
