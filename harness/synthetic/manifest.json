{
  "manifest_version": 3,
  "name": "TEST ONLY — X Feed Intelligence Synthetic Harness",
  "version": "0.1.0",
  "description": "NON-DISTRIBUTABLE test harness for authored fixtures at the reserved synthetic origin only.",
  "permissions": ["storage"],
  "host_permissions": ["https://fixture.example.invalid/*"],
  "content_scripts": [
    {
      "matches": ["https://fixture.example.invalid/*"],
      "js": ["synthetic-harness.js"],
      "all_frames": false,
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
