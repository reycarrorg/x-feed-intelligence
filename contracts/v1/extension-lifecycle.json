{
  "contract_version": "1.0.0",
  "scope": {
    "proposal": "future_live_production",
    "gate2_execution": "static_inspection_only",
    "live_origin_granted_or_exercised_through_gate2": false,
    "synthetic_browser_execution_contract": "contracts/v1/browser-test-boundary.json"
  },
  "initial_state": "INACTIVE",
  "states": [
    "INACTIVE",
    "PERMISSION_PROMPT",
    "ARMED",
    "CAPTURING",
    "PAUSED_HIDDEN",
    "LIMIT_REACHED",
    "STOPPED",
    "ERROR"
  ],
  "limits": {
    "minimum_visibility_ratio": 0.5,
    "max_candidates": 250,
    "max_duration_seconds": 1800,
    "max_packet_bytes": 5242880,
    "max_ambiguity_ratio": 0.05
  },
  "transitions": [
    {"from": "INACTIVE", "event": "USER_REQUESTS_ARM", "guard": "control_open", "to": "PERMISSION_PROMPT", "effect": "request_exact_optional_host"},
    {"from": "PERMISSION_PROMPT", "event": "PERMISSION_GRANTED", "guard": "exact_x_origin_only", "to": "ARMED", "effect": "register_isolated_script"},
    {"from": "PERMISSION_PROMPT", "event": "PERMISSION_DENIED", "guard": "always", "to": "INACTIVE", "effect": "retain_no_session_data"},
    {"from": "ARMED", "event": "USER_STARTS_SESSION", "guard": "exact_origin_visible_healthy", "to": "CAPTURING", "effect": "attach_bounded_observers"},
    {"from": "CAPTURING", "event": "DOCUMENT_HIDDEN", "guard": "always", "to": "PAUSED_HIDDEN", "effect": "detach_observers_and_dom_refs"},
    {"from": "PAUSED_HIDDEN", "event": "DOCUMENT_VISIBLE", "guard": "exact_origin_healthy_below_limits", "to": "CAPTURING", "effect": "attach_bounded_observers"},
    {"from": "CAPTURING", "event": "RESOURCE_LIMIT", "guard": "any_limit_reached", "to": "LIMIT_REACHED", "effect": "detach_observers_and_record_code_only"},
    {"from": "LIMIT_REACHED", "event": "USER_EXPORTS_OR_DISCARDS", "guard": "explicit_user_action", "to": "STOPPED", "effect": "clear_dom_refs_and_timers"},
    {"from": "CAPTURING", "event": "USER_STOPS", "guard": "always", "to": "STOPPED", "effect": "detach_and_clear_runtime_refs"},
    {"from": "ARMED", "event": "PERMISSION_REVOKED", "guard": "always", "to": "INACTIVE", "effect": "unregister_and_clear_unsaved_after_local_confirmation"},
    {"from": "CAPTURING", "event": "PERMISSION_REVOKED", "guard": "always", "to": "ERROR", "effect": "fail_closed_permission_drift"},
    {"from": "ARMED", "event": "HARD_STOP", "guard": "always", "to": "ERROR", "effect": "record_non_sensitive_code_only"},
    {"from": "CAPTURING", "event": "HARD_STOP", "guard": "always", "to": "ERROR", "effect": "detach_clear_and_record_code_only"},
    {"from": "PAUSED_HIDDEN", "event": "HARD_STOP", "guard": "always", "to": "ERROR", "effect": "clear_and_record_code_only"},
    {"from": "STOPPED", "event": "USER_DISARMS", "guard": "always", "to": "INACTIVE", "effect": "unregister_script"},
    {"from": "ERROR", "event": "USER_ACKNOWLEDGES", "guard": "no_automatic_retry", "to": "INACTIVE", "effect": "unregister_script"}
  ],
  "hard_stop_codes": [
    "LOGIN_SURFACE",
    "SIGN_OUT_STATE",
    "ACCOUNT_LOCK",
    "CAPTCHA_OR_TURNSTILE",
    "VERIFICATION_CHALLENGE",
    "UNUSUAL_ACTIVITY",
    "CONSENT_SURFACE",
    "RATE_LIMIT",
    "WRONG_ORIGIN",
    "IFRAME_BOUNDARY",
    "PERMISSION_DRIFT",
    "PARSER_VERSION_MISMATCH",
    "UNKNOWN_TOPOLOGY",
    "AMBIGUITY_LIMIT",
    "QUEUE_LIMIT",
    "DURATION_LIMIT",
    "PACKET_LIMIT",
    "DISK_OR_MEMORY_LIMIT",
    "RETENTION_FAILURE",
    "SCHEMA_MISMATCH",
    "EXCLUDED_PERMISSION_REQUEST",
    "ACCOUNT_ACTION_REQUEST",
    "INJECTION_CONTENT"
  ],
  "forbidden_effects": [
    "network_request",
    "account_action",
    "automated_scroll",
    "click",
    "key_input",
    "hover",
    "navigation",
    "refresh",
    "playback",
    "clipboard",
    "media_download",
    "cookie_read",
    "header_read",
    "page_storage_read",
    "hidden_dom_read",
    "page_world_injection",
    "automatic_retry"
  ]
}
