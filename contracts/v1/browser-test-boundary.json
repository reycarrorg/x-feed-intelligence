{
  "contract_version": "1.0.0",
  "production_proposal": {
    "manifest": "contracts/v1/manifest.proposal.json",
    "review_mode": "static_inspection_only",
    "optional_live_origin": "https://x.com/*",
    "granted_or_exercised_through_gate2": false,
    "packaged_for_distribution_through_gate2": false
  },
  "synthetic_browser_harness": {
    "manifest": "contracts/v1/manifest.synthetic-test-only.json",
    "origin": "https://fixture.example.invalid",
    "origin_resolution": "test_runner_maps_reserved_host_to_ephemeral_loopback_server",
    "isolated_profile": true,
    "outbound_network_denied": true,
    "non_distributable": true,
    "allowed_navigation_origins": ["https://fixture.example.invalid"],
    "forbidden_navigation_origins": ["https://x.com", "https://twitter.com", "https://api.x.com"]
  },
  "production_promotion_guard": {
    "required_test_only_markers": ["TEST ONLY", "NON-DISTRIBUTABLE"],
    "forbidden_bundle_paths": ["manifest.synthetic-test-only.json", "synthetic-harness.js", "fixtures/synthetic/"],
    "forbidden_production_values": ["https://fixture.example.invalid", "TEST ONLY", "NON-DISTRIBUTABLE"],
    "failure_action": "reject_package_candidate"
  }
}
