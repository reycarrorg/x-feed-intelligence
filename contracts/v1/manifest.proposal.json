{
  "manifest_version": 3,
  "name": "X Feed Intelligence Passive Collector (proposal)",
  "version": "0.1.0",
  "description": "Synthetic-test-only proposal for explicit, visible, passive collection.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://x.com/*"],
  "action": {
    "default_popup": "control.html",
    "default_title": "X Feed Intelligence is inactive"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
